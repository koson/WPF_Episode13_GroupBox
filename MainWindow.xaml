<Window x:Class="WPF_Episode13_GroupBox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Episode13_GroupBox"
        mc:Ignorable="d"
        Title="WPF Episode 13: GroupBox Demo" Height="600" Width="1000">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Navigation Panel -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="GroupBox Demos" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,20"/>
                
                <Button Content="1. Basic GroupBox" Click="ShowBasicGroupBox" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="2. Header Styles" Click="ShowHeaderStyles" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="3. Styled GroupBox" Click="ShowStyledGroupBox" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="4. Registration Form" Click="ShowRegistrationForm" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="5. Settings Panel" Click="ShowSettingsPanel" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="6. Survey Form" Click="ShowSurveyForm" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="7. Radio Groups" Click="ShowRadioGroups" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="8. Comparison" Click="ShowComparison" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="9. Nested Groups" Click="ShowNestedGroups" 
                        Margin="0,5" Padding="10,5"/>
            </StackPanel>
        </Border>
        
        <!-- Content Panel -->
        <ScrollViewer Grid.Column="1" x:Name="ContentPanel" 
                      VerticalScrollBarVisibility="Auto" 
                      Background="#ECF0F1">
            <Border Background="White" Margin="20" Padding="30" 
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Welcome to GroupBox Demo" 
                               FontSize="28" FontWeight="Bold" 
                               Margin="0,0,0,20"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10">
                        GroupBox is a content control that displays a border 
                        and header around content. It's perfect for visually 
                        grouping related controls in forms and settings.
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10">
                        Click any button on the left to see different GroupBox demos!
                    </TextBlock>
                    
                    <Border Background="LightBlue" Padding="15" Margin="0,20" 
                            CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Key Features:" FontWeight="Bold" 
                                       FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="• Visual grouping with borders" Margin="0,5"/>
                            <TextBlock Text="• Labeled headers" Margin="0,5"/>
                            <TextBlock Text="• Perfect for forms and settings" Margin="0,5"/>
                            <TextBlock Text="• Customizable styling" Margin="0,5"/>
                            <TextBlock Text="• Improves UI organization" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>